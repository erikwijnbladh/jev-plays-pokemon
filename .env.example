# Jev backend: "typesafe" (real Jev through the TypeSafe API) or "mock" (free, no key, no game sense)
JEV_MODE=mock
TYPESAFE_API_KEY=
# Pin a version (e.g. jev-1.13.0) once you tune anything against it; jev-latest moves with releases
TYPESAFE_DEFAULT_MODEL=jev-latest

# Throttling: minimum gap between Jev calls, and a hard per-minute budget
JEV_MIN_INTERVAL_MS=250
JEV_MAX_PER_MIN=90

# Loop protection: after this many decisions without progress, overworld picks are sampled from Jev's distribution
STUCK_EXPLORE=30

PLAYER_NAME=JEV
RIVAL_NAME=BLUE
ROM_PATH=roms/red.gb
